# Custom environment variables & secrets for SwipeRx Operator.
#
# Substrait reads this file when you upload the app and PRE-CREATES each entry under
# the app's Settings, so after uploading you fill in the real values in the portal.
#
#   NAME=value            → an environment variable, prefilled with `value`
#   NAME=value   # secret → a secret (write-only; masked in the portal)
#
# DO NOT list DATABASE_URL, REDIS_URL or JWT_SECRET — the platform injects those.

# --- App ---
APP_ENV=alpha
APP_VERSION=Alpha 0.1
# Public origin the app is served from. Also the OIDC redirect base and the session-cookie
# Secure flag, so it MUST stay on the platform hostname — Google SSO does not work on a
# custom domain (Substrait says so on the Domains screen). Changing it means re-registering
# the OAuth client's callback URL, or sign-in breaks.
PUBLIC_BASE_URL=https://swiperx-operator.ninjavan.apps.substrait.build

# Optional. Host used ONLY for courier links (/c/<token>). Unset = same as PUBLIC_BASE_URL.
# Courier links are unauthenticated (the token is the credential), so they are free to live
# on a short custom domain — and they need to: the link is counted TWICE inside the 500-char
# col-R budget, which on the platform hostname lands at exactly 500/500 with zero spare.
# Set this once the CNAME (-> cname.substrait.build) resolves and Verify succeeds.
# COURIER_BASE_URL=https://swrx.ninjavan.co

# --- Dev / stopgap login ---
# When "true", POST /api/auth/dev-login accepts a registered email with no Google flow.
# MUST be "false" in production. Lets us build/test before the OAuth client is registered.
DEV_LOGIN_ENABLED=true

# --- Google Workspace SSO (OIDC) ---
# Register an OAuth client for PUBLIC_BASE_URL; callback = <PUBLIC_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=   # secret
# Comma-separated Workspace domains allowed to sign in (e.g. ninjavan.co). Blank = allow any registered email.
ALLOWED_GOOGLE_DOMAINS=ninjavan.co

# --- Email (Station IC return-to-print notifications) ---
# Blank SMTP_HOST → notifications are logged only (no send). Fine for Alpha.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=   # secret
SMTP_FROM=swiperx-operator@ninjavan.co
