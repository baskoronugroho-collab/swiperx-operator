# Frontend image for Substrait — Vite/React build served by nginx on port 80.
# Built from the REPO ROOT, so COPY paths are repo-relative.
#
# The platform contract is source-only (no dist/ in the upload), so the bundle is built
# here. Verified 26 Jul 2026: a clean `npm ci && npm run build` from exactly the files in
# the deploy zip succeeds.
FROM node:24-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# Keep this on a current nginx/Alpine. Every Trivy blocker on this app has been an OS
# package in this layer (openssl, libexpat, libpng, libxml2, musl, zlib), never app code
# — 1.27-alpine sat on Alpine 3.21.3 and carried 35 of them.
#
# PINNED BY DIGEST, not by tag. Moving the tag from 1.27-alpine to 1.30-alpine alone was
# not enough: run #9000088 built green but Trivy still reported Alpine 3.21.3 with the
# identical package set, so the builder resolved the tag to a stale cached base. A digest
# cannot go stale — and if the builder's mirror lacks it, the pull fails loudly instead of
# quietly shipping the old layer. Re-pin when bumping nginx:
#   docker buildx imagetools inspect nginx:<tag> | head -2
# sha256:97d490c1… = nginx 1.30.4 on alpine-minirootfs-3.24.1
FROM nginx:1.30-alpine@sha256:97d490c12ba55b4946b01546d1c3ed324e8d41ab1c9fcb2a616aa470620e5b46

# Pull security patches Alpine has published since this base image was cut. The pin above
# fixes the base at a moment in time, so it necessarily lags.
#
# NOTE — this is currently a NO-OP on the platform builder, kept deliberately. Alpine
# v3.24/main has openssl 3.5.8-r0 (the CVE-2026-14456 fix) but the base ships 3.5.7-r0,
# and after this line ran, run #9000091 still scanned as 3.5.7-r0: the builder's apk
# mirror serves the older index, the same staleness that made the 1.30-alpine TAG resolve
# to an Alpine 3.21.3 image until it was pinned by digest. Left in place so the patch
# lands by itself once the mirror catches up. It is not the reason the build is green.
#
# Scoped to the two flagged packages rather than a blanket `apk upgrade`, so a surprise
# upstream bump cannot quietly change the rest of the runtime.
RUN apk --no-cache upgrade libcrypto3 libssl3

COPY --from=build /app/dist /usr/share/nginx/html
COPY cicd/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
