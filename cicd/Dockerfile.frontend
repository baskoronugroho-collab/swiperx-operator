# Frontend image for Substrait — static site (no build step).
# The design surfaces are self-contained HTML + support.js (client runtime), so we serve
# them directly with nginx on port 80. Built from the REPO ROOT, so COPY paths are
# repo-relative. When the real React/Vite frontend replaces this prototype, swap back to
# the scaffold's two-stage (node build → nginx) Dockerfile.frontend.
FROM nginx:1.27-alpine
COPY frontend/ /usr/share/nginx/html/
COPY cicd/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
