# Frontend image for Substrait — Vite/React build served by nginx on port 80.
# Built from the REPO ROOT, so COPY paths are repo-relative.
#
# The platform contract is source-only (no dist/ in the upload), so the bundle is built
# here. Verified 26 Jul 2026: a clean `npm ci && npm run build` from exactly the files in
# the deploy zip succeeds.
FROM node:24-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# Keep this on a current nginx/Alpine. Every Trivy blocker on this app has been an OS
# package in this layer (openssl, libexpat, libpng, libxml2, musl, zlib), never app code
# — 1.27-alpine sat on Alpine 3.21.3 and carried 35 of them.
#
# PINNED BY DIGEST, not by tag. Moving the tag from 1.27-alpine to 1.30-alpine alone was
# not enough: run #9000088 built green but Trivy still reported Alpine 3.21.3 with the
# identical package set, so the builder resolved the tag to a stale cached base. A digest
# cannot go stale — and if the builder's mirror lacks it, the pull fails loudly instead of
# quietly shipping the old layer. Re-pin when bumping nginx:
#   docker buildx imagetools inspect nginx:<tag> | head -2
#
# -ALPINE-SLIM, not -alpine (25 Sep 2026). CVE-2026-93990 needs libexpat >= 2.8.5-r0 and
# no nginx:1.30-alpine build ships it yet (latest, sha256:98522025…, still has 2.8.4-r0).
# libexpat was never ours to need: in the full image it is pulled in only by fontconfig
# <- libgd <- nginx-module-image-filter, and the full image also carries the xslt, njs,
# geoip and acme modules plus curl and ~50 X11/image/XML libraries (libuuid, libxml2,
# libpng, tiff… — the packages behind every Trivy blocker listed above). This server uses
# none of them: cicd/nginx.conf is core directives only (listen, root, index, location,
# try_files, expires, add_header) and loads no module. The slim variant is the same
# nginx build without the optional modules — same entrypoint, CMD and port 80 — so the
# whole class of finding goes away rather than being patched one CVE at a time.
# If a dynamic module is ever needed (load_module …), go back to -alpine and re-check.
#
# sha256:d9322bba… = nginx 1.30.6-r1 (Oct 2026), 21 packages, no libexpat, libuuid, libxml2
# or libgd; libssl3/libcrypto3 3.5.9-r0, musl 1.2.6-r3, zlib 1.3.2-r1. It replaces
# sha256:32463212… (nginx 1.30.5-r1), which Trivy flagged for CVE-2026-15176, CVE-2026-93479
# and CVE-2026-97205 — all fixed in nginx >= 1.30.6-r0. Verified by reading
# /lib/apk/db/installed out of its amd64 layers; the digest is the multi-arch index.
#
# Why a re-pin and not "float the tag + apk upgrade": the notes above are the evidence —
# the builder resolved a floating tag to a stale cached base and its apk mirror served a
# stale index, so `apk upgrade` changed nothing. Only a new digest reaches the build.
FROM nginx:1.30-alpine-slim@sha256:d9322bba63c6cfc63dc9e86522fd4f95fd4d9020a02b5bced282bbf38b8c3960

# No `apk upgrade` here any more. The `apk --no-cache upgrade libcrypto3 libssl3` that used
# to sit on this line never did anything on the platform builder (its apk mirror serves a
# stale index — run #9000091 still scanned 3.5.7-r0 after it ran), and the digest above
# now ships the fixed openssl itself. Every OS-package CVE in this layer is fixed by
# re-pinning the digest, not by apk — the pin is the only lever that actually reaches the
# builder.

COPY --from=build /app/dist /usr/share/nginx/html
COPY cicd/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
